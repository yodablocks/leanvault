# TypeSafe API key for Jev. Required for `judge` and `shadow`; `observe` works without it.
TYPESAFE_API_KEY=
# JSON-RPC per chain. Read-only, but 23 vaults is about 180 calls per pass and
# public endpoints throttle; an Alchemy app with both networks enabled is the
# intended setup.
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/<key>
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/<key>
# Vaults observed in parallel.
CURATOR_CONCURRENCY=4
