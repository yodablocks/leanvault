<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Runs watch-shadow.sh daily at 09:15 local time; a Mac asleep at 09:15 runs it on wake.
     The script path is this machine's clone; edit it for another. Install:
       cp curator/scripts/com.yodablocks.leanvault-shadow-watch.plist ~/Library/LaunchAgents/
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.yodablocks.leanvault-shadow-watch.plist
     Stop: launchctl bootout gui/$(id -u)/com.yodablocks.leanvault-shadow-watch -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.yodablocks.leanvault-shadow-watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/zkmarc/Coding_2026/compiler/leanvault/curator/scripts/watch-shadow.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>15</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/zkmarc/Library/Logs/leanvault-shadow-watch.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/zkmarc/Library/Logs/leanvault-shadow-watch.out</string>
</dict>
</plist>
